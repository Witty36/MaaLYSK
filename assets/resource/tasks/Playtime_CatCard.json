					},
					"next": ["进入喵喵牌页面"]
				},
				"选择黎深": {
					"focus": {
						"Node.Action.Succeeded": "进入黎深喵喵牌"
					},
					"next": ["进入喵喵牌页面"]
				},
				"选择祁煜": {
					"focus": {
						"Node.Action.Succeeded": "进入祁煜喵喵牌"
					},
					"next": ["进入喵喵牌页面"]
				},
				"选择秦彻": {
					"focus": {
						"Node.Action.Succeeded": "进入秦彻喵喵牌"
					},
					"next": ["进入喵喵牌页面"]
