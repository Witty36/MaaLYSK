					},
					"next": ["进入喵喵牌页面"]
				}
			}
		}
	],
	"option": {
		"自动消耗喵呜币抽取徽章": {
			"type": "switch",
			"description": "自动消耗全部喵呜币抽取徽章，优先抽未集齐徽章，集齐全部徽章后会随机选择一款徽章抽取。<br>活动期间自动消耗限时喵呜币抽取徽章，活动结束前最好检查一下限时喵呜币是否用完。<br><span style=\"color:yellow\">若关闭此选项，在喵呜币达到上限后将继续游玩，请留意喵呜币溢出情况。</span>",
			"cases": [
				{
					"name": "Yes",
					"pipeline_override": {
						"进入喵喵牌页面": {
							"next": [
								"[JumpBack]检查喵呜币是否上限",
								"检查喵喵牌次数",
								"[JumpBack]喵喵牌出发",
								"[JumpBack]喵喵牌再来一局",
								"[JumpBack]返回上一级页面"
							]
						},
						"检查喵喵牌次数": {
							"next": [
								"[JumpBack]检查喵呜币是否用完",
								"[JumpBack]检查活动喵呜币是否用完",
								"喵喵牌切换人物",
								"[JumpBack]返回上一级页面"
							]
						},
						"检查限时喵呜币数量": {
							"next": []
						}
					}
				},
				{
					"name": "No",
					"pipeline_override": {
						"喵喵牌出发": {
							"next": ["囤积达上限继续", "喵喵牌游戏中页面"]
						}
					}
				}
			]
		},
		"$喵呜币达上限是否继续": {
			"type": "switch",
			"description": "可选择喵呜币达上限是否继续，如果不继续的话记得检查2400巧克力有没有达到",
			"cases": [
				{
					"name": "Yes",
					"pipeline_override": {
						"喵喵牌出发": {
							"next": ["囤积达上限继续", "喵喵牌游戏中页面"]
						}
					}
				},
				{
					"name": "No",
					"pipeline_override": {
						"囤积达上限继续": {
							"action": {
								"param": {
									"target": [226, 684, 28, 16]
								}
							},
							"next": ["进入喵喵牌"]
						}
					}
				}
			]
		},
		"喵喵牌游玩男主": {
			"type": "checkbox",
			"default_case": ["沈星回", "黎深", "祁煜", "秦彻", "夏以昼"],
			"cases": [
				{
					"name": "沈星回",
					"pipeline_override": {
						"选择沈星回": {
							"enabled": true
						}
					}
				},
				{
					"name": "黎深",
					"pipeline_override": {
						"选择黎深": {
							"enabled": true
						}
					}
				},
				{
					"name": "祁煜",
					"pipeline_override": {
						"选择祁煜": {
							"enabled": true
						}
					}
				},
				{
					"name": "秦彻",
					"pipeline_override": {
						"选择秦彻": {
							"enabled": true
						}
					}
				},
				{
					"name": "夏以昼",
					"pipeline_override": {
						"选择夏以昼": {
							"enabled": true
						}
					}
				}
			]
		}
	}
